{
  "name": "my-app",
  "version": "1.0.0",
  "description": "Tech-focused landing page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-blog-og-shells.mjs && node scripts/gen-sitemap.mjs",
    "gen-og": "node scripts/gen-og-image.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "gh-pages": "^6.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.0.0",
    "vite": "^4.5.0"
  }
}
